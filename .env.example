# Public models need no secret. Never commit credentials.
VG_MODEL_ID=garystafford/wav2vec2-deepfake-voice-detector
VG_MODEL_REVISION=c66306024a7ede0be291e9c4558b37634782dc4e
# Public-ArAD options: experimental-arabic (raw) or experimental-arabic-calibrated (fitted abstention).
VG_PROFILE=base
# VG_HEAD_PATH=/path/to/a/matching/linear-head.json
VG_MAX_BYTES=15728640
VG_MAX_SECONDS=120
VG_RATE_LIMIT=6
VG_AGGREGATION=mean
# Bound CPU use and batch inference without removing audio windows.
VG_CPU_THREADS=4
VG_INFERENCE_BATCH_SIZE=3
# Set only after validation-only calibration:
# VG_CALIBRATION=models/base-calibration.json
# Optional compatible second model and immutable revision:
# VG_SECOND_MODEL=owner/model
# VG_SECOND_REVISION=full-commit-sha
